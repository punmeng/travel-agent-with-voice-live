# Default: entirely offline synthetic data; never contacts Azure.
APP_MODE=mock
PORT=3100
# Only set APP_MODE=foundry after approving cloud inference and configuring all four agents.
FOUNDRY_PROJECT_ENDPOINT=
# Management scripts additionally require this separately reviewed exact endpoint.
# Leave blank for runtime/mock use; does not authorize cloud changes by itself.
FOUNDRY_APPROVED_PROJECT_ENDPOINT=
# default uses DefaultAzureCredential; azure-cli explicitly reuses local az login.
FOUNDRY_AUTH_MODE=default
PAYMENT_PROVIDER=mock
# Setup metadata only; must match the model deployment configured on the agents.
FOUNDRY_MODEL_DEPLOYMENT=
FOUNDRY_INTENT_AGENT=
FOUNDRY_PLANNER_AGENT=
FOUNDRY_FLIGHT_AGENT=
FOUNDRY_PRICE_AGENT=
# Optional managed Voice Agent mode. One strict travel_backend function routes
# each turn through the same server-side travel backend and the four agents above.
# Leave blank to keep this mode unavailable. Creation requires the approved
# project endpoint to match FOUNDRY_PROJECT_ENDPOINT exactly.
# Create/verify with `npm run create:voice-agent -- --apply`, then pin the
# returned version here before enabling the mode in a running application.
FOUNDRY_VOICE_AGENT_NAME=
FOUNDRY_VOICE_AGENT_VERSION=
# Optional pinned versions; blank uses the existing agent's default version.
# Optional ignored .foundry\presentation.json may remap an approved exact match.
# Optional ignored .foundry\language.json enables reviewed bilingual agent versions
# only when project hash, all four names and source versions match together.
# UI language is session-scoped zh-TW/en-US; never a global environment setting.
# When absent, configured references are used unchanged.
# See docs\FOUNDRY.md; other environments keep their configured references.
FOUNDRY_INTENT_VERSION=
FOUNDRY_PLANNER_VERSION=
FOUNDRY_FLIGHT_VERSION=
FOUNDRY_PRICE_VERSION=
# Actual backend Voice Live PCM bridge; enabling uses paid Azure services.
VOICE_LIVE_ENABLED=false
VOICE_LIVE_ENDPOINT=
# Default remains the prebuilt zh-TW-HsiaoChenNeural. No recording/upload API in this app.
VOICE_LIVE_VOICE_TYPE=azure-standard
# Set type=azure-personal ONLY after approved voice is available on the SAME resource.
# Use the same-resource voice resource ID (Voice Live name), not displayName or speakerProfileId.
VOICE_LIVE_PERSONAL_VOICE_NAME=
# Optional verified second Personal Voice asset ID for the Option1 female choice.
# Client selection is a per-connection allowlisted key, never an asset ID or endpoint.
# With both assets configured: alexpun defaults male, athena selects female.
# Option4 REST/SDK continues using DIRECT_SPEECH_PERSONAL_SPEAKER_PROFILE_ID.
VOICE_LIVE_PERSONAL_VOICE_ATHENA_NAME=
VOICE_LIVE_PERSONAL_VOICE_MODEL=DragonLatestNeural
# Future Professional Voice: approved, trained and deployed on the SAME resource.
# Only type=azure-custom uses these; IDs are never inferred from Personal Voice.
VOICE_LIVE_CUSTOM_VOICE_NAME=
VOICE_LIVE_CUSTOM_VOICE_ENDPOINT_ID=
# Independent opt-in GPT-Live front end; no Personal Voice or silent fallback.
# Requires an existing gpt-live-1 deployment at this resource. No provisioning.
GPT_LIVE_ENABLED=false
GPT_LIVE_ENDPOINT=
# Architecture 2 reuses VOICE_LIVE_ENDPOINT; never activates from endpoint alone.
VOICE_LIVE_REALTIME_ENABLED=false
# This comparison specifically requires gpt-realtime-2.1. Older IDs remain unavailable.
VOICE_LIVE_REALTIME_MODEL=gpt-realtime-2.1
# Architecture 4: DIRECT Speech REST. No Voice Live API or inferred resource/profile.
DIRECT_SPEECH_ENABLED=false
DIRECT_SPEECH_ENDPOINT=
# Entra resource ID OR server-only key; never sent to the browser.
DIRECT_SPEECH_RESOURCE_ID=
DIRECT_SPEECH_KEY=
# This is a speakerProfileId GUID, NOT VOICE_LIVE_PERSONAL_VOICE_NAME.
DIRECT_SPEECH_PERSONAL_SPEAKER_PROFILE_ID=
DIRECT_SPEECH_PERSONAL_VOICE_MODEL=DragonLatestNeural
